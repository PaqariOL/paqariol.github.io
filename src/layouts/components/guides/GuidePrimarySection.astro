---
import { getEntry } from "astro:content";
import GuidesSection from "./GuidesSection.astro";

const { downloadLink, buttonLabel } = Astro.props;
const fallbackLocale = "es";
const locale = Astro.currentLocale ?? fallbackLocale;

// Astro resuelve rutas de subcarpetas utilizando getEntry de forma más consistente
let appEntry = await getEntry("pages", `${locale}/resources-guides/guide-use-ar`);

if (!appEntry) {
  appEntry = await getEntry("pages", `${fallbackLocale}/resources-guides/guide-use-ar`);
}

const app = appEntry?.data;
---

{app ? (
  <AppSection app={app} downloadLink={downloadLink} buttonLabel={buttonLabel} />
) : (
  <div class="p-4 border border-dashed border-red-300 rounded-lg text-center">
    <p class="text-red-500 font-medium">
      No se pudo cargar la entrada: src/content/pages/{locale}/resources-guides/guide-use-ar.md
    </p>
  </div>
)}
