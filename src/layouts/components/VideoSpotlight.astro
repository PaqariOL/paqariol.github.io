---
import VideoComponent from "@layouts/function-components/VideoComponent";

const { videoSection } = Astro.props;

// Íconos de las tarjetas de características (se usan en orden)
const highlightIcons = [
  "M7 2h10a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zM11 18h2M13 6l-2 4h3l-2 4",   // laboratorio portátil
  "M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.7 3h10.6a2 2 0 0 0 1.7-3l-5-9V3M7 15h10",                     // experimentos
  "M12 2l9 5v10l-9 5-9-5V7zM12 12l9-5M12 12v10M12 12L3 7",                                       // realidad aumentada
  "M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z",   // aprendizaje por proyectos
];
---
<section class="section relative overflow-hidden pt-8 sm:pt-0 pb-16">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-transparent via-paqariGreen/5 to-transparent"></div>
  <div class="container grid gap-12 lg:grid-cols-[3fr_minmax(0,2fr)] lg:items-center">
    <div class="space-y-5 order-2 lg:order-2" data-animate="fade-right">
      <p class="text-sm font-semibold uppercase tracking-[0.28em] text-primary">
        {videoSection.sectionLabel}
      </p>
      <h2 class="text-3xl md:text-4xl font-bold text-default leading-tight">
        {videoSection.title}
      </h2>
      <p class="text-lg text-text-offset" set:html={videoSection.description}>
      </p>

      {videoSection.highlights.length > 0 && (
        <ul class="grid gap-3 sm:grid-cols-2">
          {videoSection.highlights.map((item: string, i: number) => (
            <li class="highlight-item flex flex-col items-start gap-3 rounded-xl bg-background-offset/60 p-4 shadow-sm ring-1 ring-border/50">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-paqariYellow/15 text-paqariYellow">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                  <path d={highlightIcons[i % highlightIcons.length]} />
                </svg>
              </span>
              <span class="text-[15px] leading-relaxed text-text-offset" set:html={item}></span>
            </li>
          ))}
        </ul>
      )}
    </div>
    <div class="relative order-1 lg:order-1" data-animate="zoom-in">
      <div class="relative overflow-hidden rounded-[28px] border border-white/10 bg-background/70 p-2 shadow-[0_20px_80px_-24px_rgba(0,0,0,0.45)] backdrop-blur">
        <div class="absolute inset-6 -z-10 animate-rotate-sheen rounded-full bg-[conic-gradient(#217276_10deg,transparent_140deg)] opacity-80 blur-3xl"></div>
        {/* Se redujo el padding interno (p-2 sm:p-3) y se aseguró el ancho máximo (w-full max-w-[975px] mx-auto) */}
        <div class="relative rounded-3xl bg-gradient-to-br from-background via-background-offset/60 to-background p-2 sm:p-3 flex items-center justify-center w-full max-w-[975px] mx-auto">
          {videoSection.id ? (
            /* 1. Video de YouTube */
            <VideoComponent
              client:load
              src={`https://img.youtube.com/vi/${videoSection.id}/maxresdefault.jpg`}
              height={520}
              width={920}
              title={videoSection.title}
              video_id={videoSection.id}
              video_width="w-full"
              video_height="h-auto"
            />
          ) : videoSection.webm ? (
            /* 2. Animación WebM */
            <video
              autoplay
              loop
              muted
              playsinline
              class="w-full h-auto rounded-2xl object-cover shadow-lg"
            >
              <source src={videoSection.webm} type="video/webm" />
            </video>
          ) : videoSection.svg ? (
            /* 3. Animación SVG (SVGator) */
            <img
              src={videoSection.svg}
              alt={videoSection.title}
              class="w-full h-auto max-h-[750px] rounded-2xl object-contain drop-shadow-md"
            />
          ) : (
            /* 4. Imagen estática de respaldo */
            <img
              src={videoSection.image}
              alt={videoSection.title}
              class="w-full h-auto max-h-[750px] rounded-2xl object-contain shadow-lg"
            />
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Título de cada característica en su propia línea */
  .highlight-item :global(strong) {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 1rem;
    color: var(--color-text);
  }
</style>
