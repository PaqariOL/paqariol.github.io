---
import { Image } from "astro:assets";

const { app, downloadLink, buttonLabel, olderLink, olderLabel } = Astro.props;
// Each app entry can override the page-level link (e.g. the guides card)
const link = app.downloadLink ?? downloadLink;
const label = app.buttonLabel ?? buttonLabel;
const showOlder = olderLink && String(app.showOlder ?? "true") !== "false";
const layoutCols = "lg:grid-cols-[0.9fr_1.1fr]";
---

<article class={`grid gap-8 rounded-3xl border border-gray-200 bg-background p-6 shadow-xl dark:border-gray-700 ${layoutCols} lg:items-center`}>
  <div class="space-y-4">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">{app.subtitle}</p>
    <h2 class="text-3xl font-bold text-default">{app.name}</h2>
    <p class="text-sm text-text-offset">{app.description}</p>
    <ul class="space-y-2 text-sm text-text-offset">
      {app.highlights.map((item: string) => (
        <li class="flex gap-2">
          <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="grid gap-4 sm:grid-cols-2 items-stretch justify-items-center">
    <div class="flex items-center justify-center overflow-hidden rounded-2xl bg-background-offset p-3">
      <div class="h-[360px] w-full max-w-[260px]">
        <Image
          src={app.image}
          width={480}
          height={640}
          alt={app.name}
          class="h-full w-full object-contain"
        />
      </div>
    </div>
    <div class="flex w-full max-w-[260px] flex-col items-center justify-center gap-3 rounded-2xl bg-white p-3 shadow-inner">
      <Image src={app.qr} width={220} height={220} alt={`${app.name} QR`} class="h-[200px] w-[200px]" />
      <a class="btn btn-primary" href={link} target="_blank" rel="noopener noreferrer">
        {label}
      </a>
      {showOlder && (
        <a class="text-sm text-text-offset underline underline-offset-4 hover:text-primary" href={olderLink} target="_blank" rel="noopener noreferrer">
          {olderLabel}
        </a>
      )}
    </div>
  </div>
</article>
