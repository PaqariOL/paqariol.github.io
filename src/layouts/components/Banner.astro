---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from "astro:i18n";
const { banner } = Astro.props;
// Defensive defaults to avoid runtime errors during build
const { title = "", button = {}, image = "", content = "" } = banner ?? {};
const { currentLocale } = Astro;
const aboutPath = "/about";
const buttonLabel = button?.label || banner?.button_fallback_label || "";

/**
 * Render Markdown (small subset) to HTML safely:
 * - Escapes any input HTML to avoid injection
 * - Supports paragraphs (double newlines)
 * - Supports single newlines -> <br/>
 * - Supports bold (**text**) and italic (*text*)
 * This is intentionally small to avoid adding a dependency. If you need
 * full CommonMark support, add a markdown library (markdown-it/marked) as a
 * dependency and replace.
 */
const escapeHtml = (str) => String(str)
  .replace(/&/g, "&amp;")
  .replace(/</g, "&lt;")
  .replace(/>/g, "&gt;")
  .replace(/"/g, "&quot;")
  .replace(/'/g, "&#39;");

const renderMarkdown = (raw) => {
  if (!raw) return "";
  // Normalize newlines
  let s = String(raw).replace(/\r\n/g, "\n").replace(/\r/g, "\n");

  // Escape any HTML before processing markdown so HTML is not interpreted
  s = escapeHtml(s);

  // Bold **text** -> <strong>
  s = s.replace(/\*\*(.+?)\*\*/gs, '<strong>$1</strong>');
  // Italic *text* -> <em>, avoid matching **
  s = s.replace(/(^|[^*])\*(?!\*)([^*]+?)\*(?!\*)/gs, '$1<em>$2</em>');

  // Split into paragraphs on blank lines (also lines with only spaces)
  const paragraphs = s.split(/\n[ \t]*\n/g).map(p => p.trim()).filter(Boolean);
  const html = paragraphs.map(p => {
    // Replace remaining single newlines with <br/>
    const withLineBreaks = p.replace(/\n/g, '<br/>');
    return `<p>${withLineBreaks}</p>`;
  }).join('');

  return html;
};
---

<style>
  /* Separación entre frases del banner (antes era una línea en blanco completa) */
  .banner-text :global(p + p) {
    margin-top: 0.875rem;
  }
  @media (max-width: 400px) {
    .banner-heading {
      font-size: 1.8rem;
      line-height: 1.1;
    }

    .banner-text {
      font-size: 1rem;
    }
  }
</style>

<section
  class="section banner relative overflow-hidden mt-0 mb-0 flex items-center lg:min-h-[70svh]"
  style="--header-offset: var(--header-total-height, 148px); margin-top: calc(-1 * var(--header-offset)); padding-top: calc(var(--header-offset) + clamp(2.5rem, 1.5vw, 3.5rem)); padding-bottom: clamp(3rem, 3.5vw, 6rem);"
>
  <slot />
  <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-transparent via-paqariGreen/5 to-transparent"></div>
  <div class="container relative">
    <div class="grid gap-8 lg:gap-12 lg:grid-cols-[1.05fr_minmax(0,0.9fr)] lg:items-center">
      <div class="relative flex justify-center sm:justify-start lg:order-1">
        <div class="max-w-4xl space-y-8 md:space-y-5 xl:space-y-3.5 text-center sm:text-left px-2 sm:px-0">
          <h1 data-animate="fade-right" class="banner-heading banner-title text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.05] text-gray-900 dark:text-white">
            {title}
          </h1>
          <div data-animate="fade-right" class="banner-text my-2 text-lg font-semibold text-gray-700 dark:text-white/80 max-w-2xl mx-auto sm:mx-0" set:html={renderMarkdown(content ?? "")}></div>
          {button?.enable && (
            <a
              class="btn btn-primary gap-2 px-8 text-base"
              href={getRelativeLocaleUrl(currentLocale ?? "", button?.link || aboutPath)}
              data-animate="fade-right"
            >
              {buttonLabel}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.64l-3.72-3.72a.75.75 0 1 1 1.06-1.06l5 5a.75.75 0 0 1 0 1.06l-5 5a.75.75 0 1 1-1.06-1.06l3.72-3.72H3.75A.75.75 0 0 1 3 10z" clip-rule="evenodd"/></svg>
            </a>
          )}
        </div>
      </div>
        <div class="flex justify-center order-2 lg:order-2" data-animate="zoom-in">
          <div class="relative mx-auto max-w-[400px] sm:max-w-[575px] flex items-center justify-center">
            <Image
            data-animate="fade-right"
            class="w-full object-contain drop-shadow-2xl"
            alt="banner"
            src={image}
            width={720}
            height={470}
          />
        </div>
      </div>
    </div>
  </div>
</section>
